{
  "hosting": {
    "target": "poetryplease-org",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/detect.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/api/admin/manuscriptReconciliations/**",
        "function": {
          "functionId": "manuscriptreconciliationpreview"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "api"
        }
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin.html"
      },
      {
        "source": "/scoreboard",
        "destination": "/scoreboard.html"
      },
      {
        "source": "/scoreboard/**",
        "destination": "/scoreboard.html"
      },
      {
        "source": "/team-progress",
        "destination": "/team-progress.html"
      },
      {
        "source": "/team-progress/**",
        "destination": "/team-progress.html"
      },
      {
        "source": "/author-command-center",
        "destination": "/author-command-center.html"
      },
      {
        "source": "/author-command-center/**",
        "destination": "/author-command-center.html"
      },
      {
        "source": "/embed",
        "destination": "/embed.html"
      },
      {
        "source": "/embed/**",
        "destination": "/embed.html"
      },
      {
        "source": "/submit",
        "destination": "/submit.html"
      },
      {
        "source": "/submit/**",
        "destination": "/submit.html"
      },
      {
        "source": "/author/edit",
        "destination": "/author-edit.html"
      },
      {
        "source": "/author",
        "destination": "/author.html"
      },
      {
        "source": "/author/**",
        "destination": "/author.html"
      },
      {
        "source": "/m",
        "destination": "/mobile.html"
      },
      {
        "source": "/app",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
